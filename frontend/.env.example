EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1
EXPO_PUBLIC_ADS_MODE=test
# Never use production IDs during development. Test IDs are supplied automatically.

# Required only for EAS production builds. These are public native ad configuration IDs,
# not secrets. Set them in EAS environment variables, not in source control.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://YOUR-DOMAIN.example/privacy
EXPO_PUBLIC_TERMS_URL=https://YOUR-DOMAIN.example/terms
EAS_PROJECT_ID=
